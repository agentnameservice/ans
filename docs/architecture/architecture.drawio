        <mxCell id="read_b" value="receipts, badges, history, checkpoints, public key" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="read"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="index" value="" style="shape=cylinder3;html=0;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#F1F2F4;strokeColor=#7B8591;strokeWidth=1.3;" vertex="1" parent="tl"><mxGeometry x="20" y="450" width="460" height="86" as="geometry"/></mxCell>
