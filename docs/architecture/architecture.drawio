  <diagram id="ard-discovery" name="ARD Discovery">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="614" background="#ffffff" math="0" shadow="0">
