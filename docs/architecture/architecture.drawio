        <mxCell id="tree_t" value="Merkle tree" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=15;fontColor=#1F2933;fontStyle=1;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="tree"><mxGeometry x="0" y="22" width="460" height="20" as="geometry"/></mxCell>
        <mxCell id="tree_b" value="append-only, stored as tiles (Tessera)" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="tree"><mxGeometry x="0" y="44" width="460" height="42" as="geometry"/></mxCell>
        <mxCell id="cp" value="Checkpoints" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="tl"><mxGeometry x="20" y="302" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="cp_b" value="regularly signs the tree’s size and root hash" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="cp"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
