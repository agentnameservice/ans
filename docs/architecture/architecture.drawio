        <mxCell id="m16" value="⑦ call the agent directly" style="fontFamily=Helvetica, Arial, sans-serif;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=14;fontColor=#1F2933;strokeColor=#2B3440;strokeWidth=1.6;endArrow=block;endFill=1;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="234.0" y="764" as="sourcePoint"/><mxPoint x="1146.0" y="764" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note0" value="Both services keep themselves current in the background by reading ANS public records." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=13;fontColor=#5B6672;fontStyle=2;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="1220" height="20" as="geometry"/></mxCell>
        <mxCell id="note1" value="Neither is in the call path, and a client can skip either one and still verify the proof." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=13;fontColor=#5B6672;fontStyle=2;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="1220" height="20" as="geometry"/></mxCell>
