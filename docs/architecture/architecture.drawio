        <mxCell id="title" value="Inside ARD Discovery" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=22;fontColor=#1F2933;fontStyle=1;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/></mxCell>
