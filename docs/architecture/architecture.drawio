        <mxCell id="index_b" value="finds an agent’s events without scanning the tree" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="index"><mxGeometry x="0" y="44" width="460" height="42" as="geometry"/></mxCell>
        <mxCell id="ra" value="Registration Authority" style="rounded=1;absoluteArcSize=1;arcSize=12;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#E3EDFA;strokeColor=#3F6FAF;fontColor=#1F3F6E;fontSize=15;fontStyle=1;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=9;" vertex="1" parent="1"><mxGeometry x="40" y="160.0" width="240" height="62" as="geometry"/></mxCell>
        <mxCell id="ra_b" value="trusted sender" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=13;fontColor=#1F2933;fontStyle=0;align=center;verticalAlign=top;spacingTop=0;" vertex="1" parent="ra"><mxGeometry x="0" y="32" width="240" height="30" as="geometry"/></mxCell>
        <mxCell id="readers" value="Anyone, no login" style="rounded=1;absoluteArcSize=1;arcSize=12;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#E2F2E6;strokeColor=#4E8F5E;fontColor=#27512F;fontSize=15;fontStyle=1;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=9;" vertex="1" parent="1"><mxGeometry x="1000" y="472.0" width="240" height="78" as="geometry"/></mxCell>
        <mxCell id="readers_b" value="verifiers, clients,&#xa;Agent Trust Discovery" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=13;fontColor=#1F2933;fontStyle=0;align=center;verticalAlign=top;spacingTop=0;" vertex="1" parent="readers"><mxGeometry x="0" y="32" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="l1" value="signed events" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=13;fontColor=#1F2933;strokeColor=#2B3440;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="ra" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l2" value="reads" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=13;fontColor=#1F2933;strokeColor=#2B3440;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="readers" target="read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="note0" value="One signing key covers everything the log publishes," style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=13;fontColor=#5B6672;fontStyle=2;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="390.0" y="684" width="700" height="20" as="geometry"/></mxCell>
