        <mxCell id="subtitle" value="A command-line tool anyone can run. It trusts the log’s public key and nothing else." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#5B6672;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="verify" value="Verifier" style="rounded=1;absoluteArcSize=1;arcSize=16;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#F0F8F2;strokeColor=#4E8F5E;fontColor=#27512F;fontSize=18;fontStyle=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390.0" y="104" width="500" height="436" as="geometry"/></mxCell>
        <mxCell id="verify_c" value="ans-verify" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Menlo, Consolas, monospace;fontSize=12;fontColor=#5B6672;fontStyle=0;align=right;verticalAlign=top;spacingTop=0;spacingRight=20;" vertex="1" parent="verify"><mxGeometry x="0" y="19" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="find" value="Find the registration" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="verify"><mxGeometry x="20" y="56" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="find_b" value="optional: look the agent up by its domain name" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="find"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="fetch" value="Fetch the evidence" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="verify"><mxGeometry x="20" y="130" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="fetch_b" value="the log’s public key and the agent’s receipt" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="fetch"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="proof" value="Check the proof" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="verify"><mxGeometry x="20" y="204" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="proof_b" value="the event is in the Merkle tree the log signed" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="proof"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="sig" value="Check the signature" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="verify"><mxGeometry x="20" y="278" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="sig_b" value="the receipt was signed with the log’s key" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="sig"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
