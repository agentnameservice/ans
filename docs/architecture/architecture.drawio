        <mxCell id="title" value="Inside the Transparency Log" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=22;fontColor=#1F2933;fontStyle=1;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Makes registration decisions public and tamper-evident, so nobody has to take the operator’s word for it." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#5B6672;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="tl" value="Transparency Log" style="rounded=1;absoluteArcSize=1;arcSize=16;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#F0F5FC;strokeColor=#3F6FAF;fontColor=#1F3F6E;fontSize=18;fontStyle=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="390.0" y="104" width="500" height="558" as="geometry"/></mxCell>
        <mxCell id="tl_c" value="ans-tl" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Menlo, Consolas, monospace;fontSize=12;fontColor=#5B6672;fontStyle=0;align=right;verticalAlign=top;spacingTop=0;spacingRight=20;" vertex="1" parent="tl"><mxGeometry x="0" y="19" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="intake" value="Event intake" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="tl"><mxGeometry x="20" y="56" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="intake_b" value="checks each sender’s signature against registered keys" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="intake"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="seal" value="Sealing" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fontFamily=Helvetica, Arial, sans-serif;fillColor=#FFFFFF;strokeColor=#9AA7B8;fontColor=#1F2933;fontSize=15;fontStyle=1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;" vertex="1" parent="tl"><mxGeometry x="20" y="130" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="seal_b" value="countersigns each event and appends it as a leaf" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Helvetica, Arial, sans-serif;fontSize=14;fontColor=#1F2933;fontStyle=0;align=left;verticalAlign=top;spacingTop=0;spacingLeft=14;" vertex="1" parent="seal"><mxGeometry x="0" y="32" width="460" height="30" as="geometry"/></mxCell>
