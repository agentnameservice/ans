        <mxCell id="ra_svc_t" value="internal/ra/service — every external dependency&#xa;is a port interface in internal/port/ (swappable)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ra_svc"><mxGeometry x="0" y="22" width="314" height="32" as="geometry"/></mxCell>
        <mxCell id="ra_adp" value="Default adapters" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="ra"><mxGeometry x="12" y="242" width="314" height="102" as="geometry"/></mxCell>
        <mxCell id="ra_adp_t" value="SQLite store · file-based ECDSA P-256 key manager&#xa;self-signed identity CA · did:web resolver&#xa;server-cert issuer: self-signed CA or an ACME CA&#xa;   (e.g. Let’s Encrypt)&#xa;DNS verifier: noop | lookup · HTTP-01 verifier" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ra_adp"><mxGeometry x="0" y="22" width="314" height="78" as="geometry"/></mxCell>
        <mxCell id="ra_wrk" value="Outbox worker" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="ra"><mxGeometry x="12" y="362" width="150" height="72" as="geometry"/></mxCell>
        <mxCell id="ra_wrk_t" value="async delivery to the TL&#xa;replays the signed bytes&#xa;verbatim on retry" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ra_wrk"><mxGeometry x="0" y="22" width="150" height="48" as="geometry"/></mxCell>
        <mxCell id="ra_tlc" value="TL client" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="ra"><mxGeometry x="176" y="362" width="150" height="72" as="geometry"/></mxCell>
        <mxCell id="ra_tlc_t" value="seals activation events&#xa;synchronously, before&#xa;the RA reports success" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ra_tlc"><mxGeometry x="0" y="22" width="150" height="48" as="geometry"/></mxCell>
