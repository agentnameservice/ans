        <mxCell id="owner" value="Agent owner" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#C9873A;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="170" height="140" as="geometry"/></mxCell>
        <mxCell id="owner_t" value="registers the agent:&#xa;• generates identity +&#xa;   server CSRs&#xa;• calls the RA API&#xa;• publishes DNS records&#xa;   + challenge artifacts" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="owner"><mxGeometry x="0" y="22" width="170" height="118" as="geometry"/></mxCell>
        <mxCell id="zone" value="Owner’s DNS zone" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#C9873A;" vertex="1" parent="1"><mxGeometry x="60" y="372" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="zone_t" value="_ans TXT · _ans-badge TXT&#xa;SVCB / HTTPS · TLSA&#xa;DNS-01 challenge TXT&#xa;(published by the owner)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="zone"><mxGeometry x="0" y="22" width="190" height="88" as="geometry"/></mxCell>
        <mxCell id="endpoint" value="Agent endpoint" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#C9873A;" vertex="1" parent="1"><mxGeometry x="60" y="542" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="endpoint_t" value="MCP / A2A / HTTP service&#xa;serves the HTTP-01 artifact at&#xa;/.well-known/acme-challenge/…" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="endpoint"><mxGeometry x="0" y="22" width="190" height="68" as="geometry"/></mxCell>
        <mxCell id="noteA" value="ANS never writes DNS or serves challenge files&#xa;on the owner’s behalf. The RA relays the CA’s&#xa;challenges and verifies what the owner publishes." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="292" height="50" as="geometry"/></mxCell>
