        <mxCell id="ra_feed" value="GET /v1/agents/events" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="ra"><mxGeometry x="144" y="452" width="182" height="72" as="geometry"/></mxCell>
        <mxCell id="ra_feed_t" value="anonymous public events feed&#xa;TL-acknowledged rows only&#xa;(what ans-finder polls)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ra_feed"><mxGeometry x="0" y="22" width="182" height="48" as="geometry"/></mxCell>
        <mxCell id="tl" value="ans-tl — Transparency Log    :18081" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#3F6FAF;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="822" y="130" width="338" height="536" as="geometry"/></mxCell>
        <mxCell id="tl_path" value="cmd/ans-tl/main.go" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;fontColor=#666666;" vertex="1" parent="tl"><mxGeometry x="4" y="20" width="330" height="16" as="geometry"/></mxCell>
        <mxCell id="tl_pub" value="Anonymous public reads" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="tl"><mxGeometry x="12" y="42" width="314" height="108" as="geometry"/></mxCell>
        <mxCell id="tl_pub_t" value="GET /v1/agents/{agentId}   badge · /audit&#xa;/receipt (SCITT COSE_Sign1) · /status-token&#xa;GET /v1/log/checkpoint  ·  GET /root-keys&#xa;C2SP tlog-tiles:  /checkpoint · /tile/*&#xa;(public-read: true; otherwise authenticated)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="tl_pub"><mxGeometry x="0" y="22" width="314" height="84" as="geometry"/></mxCell>
        <mxCell id="tl_adm" value="Admin   /internal/v1/producer-keys" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="tl"><mxGeometry x="12" y="162" width="314" height="52" as="geometry"/></mxCell>
        <mxCell id="tl_adm_t" value="producer-key trust store (which RA keys may ingest)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="tl_adm"><mxGeometry x="0" y="22" width="314" height="28" as="geometry"/></mxCell>
        <mxCell id="tl_key" value="One ECDSA P-256 signing key" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="tl"><mxGeometry x="12" y="226" width="314" height="80" as="geometry"/></mxCell>
        <mxCell id="tl_key_t" value="signs checkpoints, attestations, receipts,&#xa;status tokens; /root-keys advertises exactly&#xa;one verification line" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="tl_key"><mxGeometry x="0" y="22" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="tl_ing" value="Authenticated ingest  (producer keys)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="tl"><mxGeometry x="12" y="318" width="314" height="122" as="geometry"/></mxCell>
        <mxCell id="tl_ing_t" value="POST /v1/internal/agents/event&#xa;POST /v2/internal/agents/event&#xa;POST /v1/internal/identities/event&#xa;body: JCS-canonical producer event · X-Signature:&#xa;detached ES256 JWS → TL wraps + signs it → logId&#xa;leaf = SHA-256(0x00 ‖ JCS(signed envelope))" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="tl_ing"><mxGeometry x="0" y="22" width="314" height="98" as="geometry"/></mxCell>
        <mxCell id="tl_db" value="SQLite index&#xa;events · checkpoints&#xa;receipts · producer keys" style="fontFamily=Helvetica, Arial, sans-serif;shape=cylinder3;html=0;boundedLbl=1;backgroundOutline=1;size=9;fontSize=12;fillColor=#F2F2F2;strokeColor=#7A7A7A;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="tl"><mxGeometry x="12" y="452" width="146" height="72" as="geometry"/></mxCell>
        <mxCell id="tl_tiles" value="Tessera POSIX tiles&#xa;append-only Merkle tree&#xa;(RFC 6962 leaves)" style="fontFamily=Helvetica, Arial, sans-serif;shape=cylinder3;html=0;boundedLbl=1;backgroundOutline=1;size=9;fontSize=12;fillColor=#F2F2F2;strokeColor=#7A7A7A;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="tl"><mxGeometry x="180" y="452" width="146" height="72" as="geometry"/></mxCell>
        <mxCell id="fd" value="ans-finder — discovery catalog    :18082" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#3F6FAF;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="382" y="712" width="778" height="180" as="geometry"/></mxCell>
        <mxCell id="fd_path" value="cmd/ans-finder/main.go   ·   docs/architecture/ans-finder.md" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;fontColor=#666666;" vertex="1" parent="fd"><mxGeometry x="4" y="20" width="600" height="16" as="geometry"/></mxCell>
        <mxCell id="fd_pol" value="Feed poller" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="fd"><mxGeometry x="12" y="44" width="186" height="72" as="geometry"/></mxCell>
        <mxCell id="fd_pol_t" value="GET /v1/agents/events&#xa;lastLogId cursor; projects&#xa;events into catalog entries" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="fd_pol"><mxGeometry x="0" y="22" width="186" height="48" as="geometry"/></mxCell>
        <mxCell id="fd_db" value="SQLite FTS5&#xa;catalog index" style="fontFamily=Helvetica, Arial, sans-serif;shape=cylinder3;html=0;boundedLbl=1;backgroundOutline=1;size=9;fontSize=12;fillColor=#F2F2F2;strokeColor=#7A7A7A;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="fd"><mxGeometry x="230" y="44" width="120" height="72" as="geometry"/></mxCell>
        <mxCell id="fd_api" value="Anonymous, rate-limited API" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#F8FAFD;strokeColor=#9AA7B8;" vertex="1" parent="fd"><mxGeometry x="382" y="44" width="384" height="72" as="geometry"/></mxCell>
        <mxCell id="fd_api_t" value="POST /v1/search  ·  POST /v1/explore&#xa;every result carries the agent’s TL receipt URI&#xa;clients verify against the TL, not the finder" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="fd_api"><mxGeometry x="0" y="22" width="384" height="48" as="geometry"/></mxCell>
        <mxCell id="fd_note" value="The finder never talks to the TL: it hands clients the TL URLs they need to check its results." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;fontStyle=2;fontColor=#666666;" vertex="1" parent="fd"><mxGeometry x="4" y="130" width="700" height="18" as="geometry"/></mxCell>
        <mxCell id="ver" value="ans-verify — offline verifier CLI" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#4E8F5E;" vertex="1" parent="1"><mxGeometry x="1322" y="172" width="268" height="134" as="geometry"/></mxCell>
        <mxCell id="ver_t" value="cmd/ans-verify&#xa;fetches /root-keys + the SCITT receipt,&#xa;walks the Merkle inclusion proof,&#xa;verifies ES256 (kid → root key),&#xa;cross-checks the badge → VERIFIED&#xa;by name:  -fqdn → _ans-badge.&lt;fqdn&gt; TXT  ⑧" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ver"><mxGeometry x="0" y="22" width="268" height="110" as="geometry"/></mxCell>
        <mxCell id="orc" value="Any client / AI orchestrator" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#4E8F5E;" vertex="1" parent="1"><mxGeometry x="1322" y="728" width="268" height="112" as="geometry"/></mxCell>
        <mxCell id="orc_t" value="searches the finder  ⑥&#xa;then verifies the result against the TL  ⑦&#xa;— without trusting the finder" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="orc"><mxGeometry x="0" y="22" width="268" height="60" as="geometry"/></mxCell>
        <mxCell id="dev" value="Local development only" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="924" width="540" height="108" as="geometry"/></mxCell>
        <mxCell id="dev_dns" value="ans-dns    :15353" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="dev"><mxGeometry x="12" y="32" width="256" height="64" as="geometry"/></mxCell>
        <mxCell id="dev_dns_t" value="cmd/ans-dns · authoritative dev DNS server&#xa;install / clear subcommands (verify-dns flow)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="dev_dns"><mxGeometry x="0" y="22" width="256" height="40" as="geometry"/></mxCell>
        <mxCell id="dev_demo" value="scripts/demo/*" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="dev"><mxGeometry x="280" y="32" width="248" height="64" as="geometry"/></mxCell>
        <mxCell id="dev_demo_t" value="start.sh · run-lifecycle.sh · stop.sh&#xa;end-to-end lifecycle on a local stack" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="dev_demo"><mxGeometry x="0" y="22" width="248" height="40" as="geometry"/></mxCell>
        <mxCell id="key" value="Lifecycle (numbered edges)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fontFamily=Helvetica, Arial, sans-serif;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="596" y="924" width="1004" height="108" as="geometry"/></mxCell>
        <mxCell id="key_l" value="① Owner registers: POST /v2/ans/agents with identity + server CSRs (authenticated)&#xa;② RA relays the CA’s domain-control challenges; owner publishes DNS-01 TXT / HTTP-01&#xa;③ verify-acme issues the certs; verify-dns checks _ans / _ans-badge / SVCB / TLSA → ACTIVE&#xa;④ RA → TL: signed event (X-Signature = detached ES256 JWS). Activation is sealed before the RA&#xa;     reports success; revocation and other lifecycle events ride the outbox worker. TL returns a logId." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="key"><mxGeometry x="4" y="24" width="520" height="80" as="geometry"/></mxCell>
        <mxCell id="key_r" value="⑤ Finder polls GET /v1/agents/events (TL-acknowledged rows only) into its FTS5 catalog&#xa;⑥ Client → Finder: POST /v1/search; every result carries the agent’s TL receipt URI&#xa;⑦ Verifier → TL: /root-keys, receipt, badge, checkpoint, tiles → proof checked offline&#xa;⑧ Optional: _ans-badge.&lt;fqdn&gt; TXT lookup resolves an agent name to its agentId" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="key"><mxGeometry x="528" y="24" width="472" height="80" as="geometry"/></mxCell>
        <mxCell id="leg_solid" value="" style="fontFamily=Helvetica, Arial, sans-serif;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="937" as="sourcePoint"/><mxPoint x="1280" y="937" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="leg_solid_t" value="runtime call" style="fontFamily=Helvetica, Arial, sans-serif;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1286" y="927" width="90" height="20" as="geometry"/></mxCell>
        <mxCell id="leg_dashed" value="" style="fontFamily=Helvetica, Arial, sans-serif;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="937" as="sourcePoint"/><mxPoint x="1410" y="937" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="leg_dashed_t" value="async · poll · optional" style="fontFamily=Helvetica, Arial, sans-serif;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1416" y="927" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="e1" value="① POST /v2/ans/agents&#xa;identity + server CSRs" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2286;exitDx=0;exitDy=0;entryX=0;entryY=0.2667;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="ra_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="② challenges relayed&#xa;DNS-01 TXT · HTTP-01" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5143;entryDx=0;entryDy=0;" edge="1" parent="1" source="ra_api" target="owner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="③ verify-acme → certs&#xa;verify-dns → ACTIVE" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.9333;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="ra_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_dns" value="DNS lookups&#xa;(lookup verifier)" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=0;exitY=0.4706;exitDx=0;exitDy=0;entryX=1;entryY=0.4364;entryDx=0;entryDy=0;" edge="1" parent="1" source="ra_adp" target="zone"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_http" value="HTTP-01 fetch" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=0;exitY=0.8235;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ra_adp" target="endpoint"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="456"/><mxPoint x="330" y="587"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="④ signed event&#xa;detached JWS in&#xa;X-Signature" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6557;entryDx=0;entryDy=0;" edge="1" parent="1" source="ra_tlc" target="tl_ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="⑤ polls the feed&#xa;TL-acked rows only" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.2288;exitY=0;exitDx=0;exitDy=0;entryX=0.1868;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fd" target="ra_feed"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="78" y="6" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_f1" value="" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fd_pol" target="fd_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_f2" value="" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fd_db" target="fd_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="⑥ POST /v1/search&#xa;→ TL receipt URIs" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5714;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orc" target="fd_api"><mxGeometry x="-0.253" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6b" value="verifies ⑦&#xa;(no credentials)" style="fontFamily=Helvetica, Arial, sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;fontSize=12;fontColor=#1A1A1A;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.2589;exitDx=0;exitDy=0;entryX=1;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="orc" target="tl_pub"><mxGeometry x="-0.034" relative="1" as="geometry"><mxPoint x="58" y="0" as="offset"/><Array as="points"><mxPoint x="1250" y="757"/><mxPoint x="1250" y="250"/></Array></mxGeometry></mxCell>
