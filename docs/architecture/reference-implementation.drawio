        <mxCell id="ra_api_t" value="V1   /v1/agents/…&#xa;V2   /v2/ans/agents/…   ·   /v2/ans/identities/…&#xa;register · verify-acme · verify-dns · revoke&#xa;certificates · renewal · identity links" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;spacingLeft=8;spacingTop=0;fontFamily=Helvetica, Arial, sans-serif;" vertex="1" parent="ra_api"><mxGeometry x="0" y="22" width="314" height="96" as="geometry"/></mxCell>
